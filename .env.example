# ==============================================================================
# Vantor Capital Markets — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ==============================================================================

# --- Database (required) ------------------------------------------------------
# PostgreSQL connection string used by the app and by drizzle-kit migrations.
# Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://vantor:vantor_dev_password@localhost:5432/vantor_dev

# Connection string used only when running the automated test suite.
# Optional for running the app; required for `pnpm test`.
TEST_DATABASE_URL=postgres://vantor:vantor_dev_password@localhost:5432/vantor_test

# Max database connections per server instance. Optional; default 5.
# Keep small (1–5) on serverless hosts like Vercel. Example: 3
DB_POOL_MAX=5

# --- Authentication (required) ------------------------------------------------
# Secret used to sign session tokens. Generate with: openssl rand -base64 32
# Required in every environment. Must be unique per environment.
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32

# Canonical URL the app is served from (no trailing slash).
# Used for auth callback/origin validation.
# Example (production): https://vantor.com
BETTER_AUTH_URL=http://localhost:3000

# --- Platform administration (optional) ---------------------------------------
# Comma-separated list of email addresses treated as platform admins in
# DEVELOPMENT AND TEST ONLY. Production ignores this variable (open signup +
# unverified emails would let an attacker claim a listed address); grant
# production admins with `pnpm admin:grant <email>` instead.
# Example: admin@vantor.com,ops@vantor.com
ADMIN_EMAILS=

# --- Development seeding (optional) -------------------------------------------
# Safety switch for `pnpm db:seed`. Seeding refuses to run unless this is "true"
# so demo companies can never be inserted into a production database by accident.
# Set to true locally only when you want demo data; never set it in Vercel.
ALLOW_SEED=false

# Second safety switch for `pnpm db:seed`: seeding a database whose host is not
# localhost additionally requires naming that exact host here. Leave unset.
# Example: ALLOW_SEED_REMOTE_HOST=db.example.railway.app
ALLOW_SEED_REMOTE_HOST=
